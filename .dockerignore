# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
env/

# Git and CI
.git/
.github/
.gitignore
.gitattributes
.pre-commit-config.yaml
.prettierrc.js

# Editor settings
.vscode/
.idea/

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Logs
*.log

# Build artifacts
build/
dist/
sdist/
wheels/

# Test artifacts
outputs-smoke/

# Large outputs that are not needed in the container
