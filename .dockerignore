outputs/

# Unused data (only online-poster-sample-hf is used by the viewer)
data/nerfstudio/
data/online-poster-sample/

# Documentation (50 MB — not needed in container)
docs/

# Colab
colab/

# Package manager files not used in Docker
pixi.toml
pixi.lock

# Misc
.DS_Store
*.spec
*.manifest
temp*
old/
