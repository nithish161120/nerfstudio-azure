{
    "name": "NerfStudio on Codespaces",
    "image": "mcr.microsoft.com/devcontainers/python:3.10-bullseye",
    "forwardPorts": [7007, 8888],
    "portsAttributes": {
        "8888": {
            "label": "JupyterLab",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    },
    "postCreateCommand": "pip install --quiet jupyterlab torch torchvision --index-url https://download.pytorch.org/whl/cpu && pip install --quiet nerfstudio --no-deps && pip install --quiet tyro rich jaxtyping einops",
    "postStartCommand": "nohup jupyter-lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --IdentityProvider.token= > /tmp/jupyter.log 2>&1 &",
    "remoteEnv": {
        "PYTHONUTF8": "1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    }
}
